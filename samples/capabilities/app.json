{
  "name": "能力集合",
  "description": "用于体验和验证页面、组件、设备能力及运行时接口的综合示例。",
  "pages": [
    "pages/index/index",
    "pages/open/index"
  ],
  "widgets": [
    {
      "path": "widgets/counter/index",
      "family": "1x1"
    },
    {
      "path": "widgets/runtime-status/index",
      "family": "1x2"
    },
    {
      "path": "widgets/clock/index",
      "family": "1x1"
    },
    {
      "path": "widgets/battery/index",
      "family": "1x1"
    },
    {
      "path": "widgets/weather/index",
      "family": "1x2"
    },
    {
      "path": "widgets/now-playing/index",
      "family": "1x2"
    },
    {
      "path": "widgets/image/index",
      "family": "1x2"
    },
    {
      "path": "widgets/canvas/index",
      "family": "1x2"
    },
    {
      "path": "widgets/component-case/index",
      "family": "1x2"
    },
    {
      "path": "widgets/video-context-case/index",
      "family": "1x2"
    },
    {
      "path": "widgets/a2ui-context-case/index",
      "family": "1x2"
    },
    {
      "path": "widgets/media-relative-case/index",
      "family": "1x2"
    }
  ],
  "permissions": [
    "GEOLOCATION",
    "CAMERA",
    "RECORD_AUDIO"
  ],
  "usingComponents": {
    "workflow-panel": "components/workflow-panel",
    "workflow-node": "components/workflow-node"
  },
  "fonts": [
    {
      "family": "Bundled Serif",
      "src": "assets/fonts/NotoSerif-Regular.ttf",
      "weight": 400,
      "style": "normal"
    },
    {
      "family": "Bundled Serif",
      "src": "assets/fonts/NotoSerif-BoldItalic.ttf",
      "weight": 700,
      "style": "italic"
    }
  ],
  "window": {
    "navigationBarTitleText": "Ink Demo",
    "viewport": {
      "width": "device-width"
    }
  }
}
