{
  "schemaVersion": 1,
  "id": "049-no-dom-activate",
  "category": "constraint",
  "difficulty": "medium",
  "description": "The existing Page shows active initially false. Add an Activate button that switches active to true using AIUI events and setData; avoid browser DOM APIs.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Activate"
      },
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Activate"
          }
        ],
        "expect": {
          "active": true
        },
        "minPatches": 1
      },
      {
        "id": "two-taps",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Activate"
          },
          {
            "button": "Activate"
          }
        ],
        "expect": {
          "active": true
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "active"
      },
      {
        "id": "initial",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "active": false
        }
      }
    ],
    "constraints": [
      {
        "id": "no-dom",
        "type": "noDom"
      }
    ]
  }
}
