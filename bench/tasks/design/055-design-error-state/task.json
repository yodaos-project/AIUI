{
  "schemaVersion": 1,
  "id": "055-design-error-state",
  "category": "design",
  "difficulty": "medium",
  "description": "Replace the red error card in pages/index/index.ink with redundant green-only error semantics. Keep ERROR and the bound message Connection lost visible, and add a separate text node with class error-icon containing the triangle glyph △. The .error panel uses 6% green fill, 1px dashed 72% green boundary, 4px radius, and 8px padding on all sides. Label, message and triangle use 12px/400 sans-serif at 72% green. Retry must increment attempts from 0 while preserving the message. Use the local DESIGN.md excerpt of the monochrome-green specification. Keep the supplied class names on their existing content nodes. For deterministic source grading, use flat .class selectors (comma lists are allowed) and explicit longhand properties in the inline <style> block; do not use imports, variables, shorthands, complex selectors, or !important. Preserve the route, bound content, initial state, and existing button behavior. Use AIUI APIs, not browser DOM APIs.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "severity-panel",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "error",
        "tag": "view",
        "declarations": {
          "background-color": "rgba(64,255,94,0.06)",
          "border-width": "1px",
          "border-style": "dashed",
          "border-color": "rgba(64,255,94,0.72)",
          "border-radius": "4px",
          "padding-top": "8px",
          "padding-bottom": "8px",
          "padding-left": "8px",
          "padding-right": "8px"
        }
      },
      {
        "id": "explicit-label",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "error-label",
        "tag": "text",
        "declarations": {
          "color": "rgba(64,255,94,0.72)",
          "font-family": "sans-serif",
          "font-size": "12px",
          "font-weight": "400"
        },
        "text": "ERROR"
      },
      {
        "id": "readable-message",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "error-message",
        "tag": "text",
        "declarations": {
          "color": "rgba(64,255,94,0.72)",
          "font-family": "sans-serif",
          "font-size": "12px",
          "font-weight": "400"
        },
        "binding": "message"
      },
      {
        "id": "triangle-cue",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "error-icon",
        "tag": "text",
        "declarations": {
          "color": "rgba(64,255,94,0.72)",
          "font-family": "sans-serif",
          "font-size": "12px",
          "font-weight": "400"
        },
        "text": "△"
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "initial-state",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "message": "Connection lost",
          "attempts": 0
        },
        "calls": []
      },
      {
        "id": "existing-action",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "message": "Connection lost",
          "attempts": 1
        },
        "calls": [
          {
            "button": "Retry"
          }
        ]
      },
      {
        "id": "bound-message",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "message"
      },
      {
        "id": "bound-attempts",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "attempts"
      }
    ],
    "constraints": [
      {
        "id": "no-dom",
        "type": "noDom"
      }
    ]
  }
}
