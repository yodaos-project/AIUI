{
  "schemaVersion": 1,
  "id": "055-design-error-state",
  "category": "design",
  "difficulty": "medium",
  "description": "Improve the connection error presentation in pages/index/index.ink for RokidGlasses1 and RokidGlasses2. Make the severity recognizable on their display, with a visible error symbol as well as the ERROR label and bound Connection lost message. Preserve the Retry button that increments attempts from 0 without changing the message.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "severity-panel",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "error",
        "tag": "view",
        "declarations": {
          "background-color": "rgba(64,255,94,0.06)",
          "border-width": "1px",
          "border-style": "dashed",
          "border-color": "rgba(64,255,94,0.72)",
          "border-radius": "4px",
          "padding-top": "8px",
          "padding-bottom": "8px",
          "padding-left": "8px",
          "padding-right": "8px"
        }
      },
      {
        "id": "explicit-label",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "error-label",
        "tag": "text",
        "declarations": {
          "color": "rgba(64,255,94,0.72)",
          "font-family": "sans-serif",
          "font-size": "12px",
          "font-weight": "400"
        },
        "text": "ERROR"
      },
      {
        "id": "readable-message",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "error-message",
        "tag": "text",
        "declarations": {
          "color": "rgba(64,255,94,0.72)",
          "font-family": "sans-serif",
          "font-size": "12px",
          "font-weight": "400"
        },
        "binding": "message"
      },
      {
        "id": "triangle-cue",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "error-icon",
        "tag": "text",
        "declarations": {
          "color": "rgba(64,255,94,0.72)",
          "font-family": "sans-serif",
          "font-size": "12px",
          "font-weight": "400"
        },
        "text": "△"
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "initial-state",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "message": "Connection lost",
          "attempts": 0
        },
        "calls": []
      },
      {
        "id": "existing-action",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "message": "Connection lost",
          "attempts": 1
        },
        "calls": [
          {
            "button": "Retry"
          }
        ]
      },
      {
        "id": "bound-message",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "message"
      },
      {
        "id": "bound-attempts",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "attempts"
      }
    ],
    "constraints": [
      {
        "id": "no-dom",
        "type": "noDom"
      }
    ]
  }
}
