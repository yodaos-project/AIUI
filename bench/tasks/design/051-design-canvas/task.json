{
  "schemaVersion": 1,
  "id": "051-design-canvas",
  "category": "design",
  "difficulty": "easy",
  "description": "Adapt the Home HUD canvas in pages/index/index.ink for RokidGlasses1 and RokidGlasses2. Keep the content comfortably inside the visible field and the Home title readable over the real-world background. Preserve the displayed count, starting at 0, and the Advance button that increments it.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "safe-canvas",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "canvas",
        "tag": "view",
        "declarations": {
          "width": "480px",
          "height": "352px",
          "box-sizing": "border-box",
          "padding-top": "12px",
          "padding-bottom": "12px",
          "padding-left": "16px",
          "padding-right": "16px",
          "background-color": "#000000"
        }
      },
      {
        "id": "readable-title",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "title",
        "tag": "text",
        "declarations": {
          "color": "rgba(64,255,94,0.72)",
          "font-family": "sans-serif",
          "font-size": "14px",
          "font-weight": "400"
        },
        "binding": "title"
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "initial-state",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "title": "Home",
          "count": 0
        },
        "calls": []
      },
      {
        "id": "existing-action",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "title": "Home",
          "count": 1
        },
        "calls": [
          {
            "button": "Advance"
          }
        ]
      },
      {
        "id": "bound-title",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "title"
      },
      {
        "id": "bound-count",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "count"
      }
    ],
    "constraints": [
      {
        "id": "no-dom",
        "type": "noDom"
      }
    ]
  }
}
