{
  "schemaVersion": 1,
  "id": "052-design-typography",
  "category": "design",
  "difficulty": "medium",
  "description": "Improve the telemetry text hierarchy in pages/index/index.ink for RokidGlasses1 and RokidGlasses2: distinguish the Telemetry title, the numerical reading, and the secondary Sensor A metadata. Preserve all bound content and the Refresh button that increases the reading from its initial value of 42.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "display-title",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "title",
        "tag": "text",
        "declarations": {
          "font-family": "sans-serif",
          "font-size": "22px",
          "font-weight": "500",
          "color": "rgba(64,255,94,0.72)"
        },
        "binding": "title"
      },
      {
        "id": "numeric-data",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "value",
        "tag": "text",
        "declarations": {
          "font-family": "monospace",
          "font-size": "13px",
          "font-weight": "500",
          "color": "#40ff5e"
        },
        "binding": "value"
      },
      {
        "id": "secondary-metadata",
        "type": "style",
        "path": "pages/index/index.ink",
        "className": "metadata",
        "tag": "text",
        "declarations": {
          "font-family": "sans-serif",
          "font-size": "12px",
          "font-weight": "400",
          "color": "rgba(64,255,94,0.48)"
        },
        "binding": "metadata"
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "initial-state",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "title": "Telemetry",
          "value": 42,
          "metadata": "Sensor A"
        },
        "calls": []
      },
      {
        "id": "existing-action",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "title": "Telemetry",
          "value": 43,
          "metadata": "Sensor A"
        },
        "calls": [
          {
            "button": "Refresh"
          }
        ]
      },
      {
        "id": "bound-title",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "title"
      },
      {
        "id": "bound-value",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "value"
      },
      {
        "id": "bound-metadata",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "metadata"
      }
    ],
    "constraints": [
      {
        "id": "no-dom",
        "type": "noDom"
      }
    ]
  }
}
