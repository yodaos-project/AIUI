{
  "schemaVersion": 1,
  "id": "019-migrate-page",
  "category": "migrate",
  "difficulty": "medium",
  "description": "Migrate the existing Home Page from unsupported Page({...}) registration to an export default object. Preserve its counter, Increment button, and route. One tap should show count 1 and two taps count 2.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Increment"
          }
        ],
        "expect": {
          "count": 1
        },
        "minPatches": 1
      },
      {
        "id": "second-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Increment"
          },
          {
            "button": "Increment"
          }
        ],
        "expect": {
          "count": 2
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "count",
        "eventLabel": "Increment"
      }
    ],
    "constraints": []
  }
}
