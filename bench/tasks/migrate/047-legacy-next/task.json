{
  "schemaVersion": 1,
  "id": "047-legacy-next",
  "category": "migrate",
  "difficulty": "medium",
  "description": "Migrate the legacy Page registration to export default and preserve the Next Track button behavior.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Next Track"
      },
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Next Track"
          }
        ],
        "expect": {
          "track": 2
        },
        "minPatches": 1
      },
      {
        "id": "two-taps",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Next Track"
          },
          {
            "button": "Next Track"
          }
        ],
        "expect": {
          "track": 3
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "track"
      },
      {
        "id": "initial",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "track": 1
        }
      }
    ],
    "constraints": []
  }
}
