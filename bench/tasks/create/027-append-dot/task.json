{
  "schemaVersion": 1,
  "id": "027-append-dot",
  "category": "create",
  "difficulty": "easy",
  "description": "Create a Page at pages/index/index with bound message initially \"A\". Add an Append button that adds a dot to message.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "page",
        "type": "file",
        "path": "pages/index/index.ink"
      },
      {
        "id": "button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Append"
      },
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Append"
          }
        ],
        "expect": {
          "message": "A."
        },
        "minPatches": 1
      },
      {
        "id": "two-taps",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Append"
          },
          {
            "button": "Append"
          }
        ],
        "expect": {
          "message": "A.."
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      }
    ],
    "constraints": []
  }
}
