{
  "schemaVersion": 1,
  "id": "023-toggle-light",
  "category": "create",
  "difficulty": "easy",
  "description": "Create a Page at pages/index/index with bound lit initially false. Add a Toggle Light button that switches lit between false and true.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "page",
        "type": "file",
        "path": "pages/index/index.ink"
      },
      {
        "id": "button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Toggle Light"
      },
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Toggle Light"
          }
        ],
        "expect": {
          "lit": true
        },
        "minPatches": 1
      },
      {
        "id": "two-taps",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Toggle Light"
          },
          {
            "button": "Toggle Light"
          }
        ],
        "expect": {
          "lit": false
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      }
    ],
    "constraints": []
  }
}
