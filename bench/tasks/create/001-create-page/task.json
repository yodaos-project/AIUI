{
  "schemaVersion": 1,
  "id": "001-create-page",
  "category": "create",
  "difficulty": "easy",
  "description": "Create a minimal AIUI Page at pages/index/index. Show the text Hello AIUI using bound Page data. Keep the project packageable.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "page",
        "type": "file",
        "path": "pages/index/index.ink"
      },
      {
        "id": "hello",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "text",
        "binding": "message"
      },
      {
        "id": "initial-message",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "message": "Hello AIUI"
        }
      }
    ],
    "regression": [],
    "constraints": []
  }
}
