{
  "schemaVersion": 1,
  "id": "020-counter-step",
  "category": "create",
  "difficulty": "easy",
  "description": "Create a Page at pages/index/index with bound count initially 0. Add a Step button that increases count by 3.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "page",
        "type": "file",
        "path": "pages/index/index.ink"
      },
      {
        "id": "button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Step"
      },
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Step"
          }
        ],
        "expect": {
          "count": 3
        },
        "minPatches": 1
      },
      {
        "id": "two-taps",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Step"
          },
          {
            "button": "Step"
          }
        ],
        "expect": {
          "count": 6
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      }
    ],
    "constraints": []
  }
}
