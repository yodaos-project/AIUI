{
  "schemaVersion": 1,
  "id": "025-double-total",
  "category": "create",
  "difficulty": "easy",
  "description": "Create a Page at pages/index/index with bound total initially 2. Add a Double button that doubles total.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "page",
        "type": "file",
        "path": "pages/index/index.ink"
      },
      {
        "id": "button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Double"
      },
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Double"
          }
        ],
        "expect": {
          "total": 4
        },
        "minPatches": 1
      },
      {
        "id": "two-taps",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Double"
          },
          {
            "button": "Double"
          }
        ],
        "expect": {
          "total": 8
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      }
    ],
    "constraints": []
  }
}
