{
  "schemaVersion": 1,
  "id": "036-subtract-credit",
  "category": "modify",
  "difficulty": "medium",
  "description": "Add a Spend button that decreases credits by 2. Preserve the Home title.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Spend"
      },
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Spend"
          }
        ],
        "expect": {
          "credits": 8
        },
        "minPatches": 1
      },
      {
        "id": "two-taps",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Spend"
          },
          {
            "button": "Spend"
          }
        ],
        "expect": {
          "credits": 6
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "credits"
      },
      {
        "id": "initial",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "title": "Home",
          "credits": 10
        }
      },
      {
        "id": "title-binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "title"
      }
    ],
    "constraints": []
  }
}
