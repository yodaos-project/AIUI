{
  "schemaVersion": 1,
  "id": "035-add-item",
  "category": "modify",
  "difficulty": "medium",
  "description": "Add an Add Item button that increases items by 1. Preserve the Home title.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Add Item"
      },
      {
        "id": "first-tap",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Add Item"
          }
        ],
        "expect": {
          "items": 3
        },
        "minPatches": 1
      },
      {
        "id": "two-taps",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "button": "Add Item"
          },
          {
            "button": "Add Item"
          }
        ],
        "expect": {
          "items": 4
        },
        "minPatches": 2
      }
    ],
    "regression": [
      {
        "id": "route",
        "type": "route",
        "value": "pages/index/index"
      },
      {
        "id": "binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "items"
      },
      {
        "id": "initial",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "title": "Home",
          "items": 2
        }
      },
      {
        "id": "title-binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "title"
      }
    ],
    "constraints": []
  }
}
