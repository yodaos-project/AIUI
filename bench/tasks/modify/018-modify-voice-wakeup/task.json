{
  "schemaVersion": 1,
  "id": "018-modify-voice-wakeup",
  "category": "modify",
  "difficulty": "medium",
  "description": "The Home Page currently counts only one wake word. Update onVoiceWakeup so both voice and touch wakeups increase wakeups, regardless of keyword. Preserve the visible wakeups binding and initial count 0.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "all-wakeups",
        "type": "voiceBehavior",
        "path": "pages/index/index.ink",
        "events": [
          {
            "keyword": "Hi Rokid"
          },
          {
            "keyword": "clickAiAssist"
          }
        ],
        "expect": {
          "wakeups": 2
        }
      },
      {
        "id": "one-touch",
        "type": "voiceBehavior",
        "path": "pages/index/index.ink",
        "events": [
          {
            "keyword": "clickAiAssist"
          }
        ],
        "expect": {
          "wakeups": 1
        }
      }
    ],
    "regression": [
      {
        "id": "initial",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "wakeups": 0
        }
      },
      {
        "id": "binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "wakeups"
      }
    ],
    "constraints": []
  }
}
