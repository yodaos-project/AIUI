{
  "schemaVersion": 1,
  "id": "013-modify-watch",
  "category": "modify",
  "difficulty": "hard",
  "description": "Add a Watch button to the Home Page that starts navigator.geolocation.watchPosition and displays the latest latitude and longitude. Keep the returned watch ID and clear it in onUnload. Declare GEOLOCATION in app.json. Preserve the Home title.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "permission",
        "type": "permission",
        "value": "GEOLOCATION"
      },
      {
        "id": "watch-button",
        "type": "template",
        "path": "pages/index/index.ink",
        "tag": "button",
        "eventLabel": "Watch"
      },
      {
        "id": "watch-cleanup",
        "type": "watchBehavior",
        "path": "pages/index/index.ink",
        "buttonLabel": "Watch",
        "stopMethod": "onUnload",
        "expect": {
          "latitude": 30,
          "longitude": 120
        }
      },
      {
        "id": "watch-updated-position",
        "type": "watchBehavior",
        "path": "pages/index/index.ink",
        "buttonLabel": "Watch",
        "stopMethod": "onUnload",
        "position": { "latitude": 31, "longitude": 121 },
        "expect": { "latitude": 31, "longitude": 121 }
      }
    ],
    "regression": [
      {
        "id": "title",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "expect": {
          "title": "Home"
        }
      },
      {
        "id": "title-binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "title"
      }
    ],
    "constraints": []
  }
}
