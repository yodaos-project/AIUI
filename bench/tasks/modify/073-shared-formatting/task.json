{
  "schemaVersion": 1,
  "id": "073-shared-formatting",
  "category": "modify",
  "difficulty": "hard",
  "description": "Update the shared distance formatter used by the page and status Widget: render one decimal place followed by km for every supplied numeric reading, including zero and negative readings. Both surfaces must refresh from their own reading without breaking each other. Preserve existing bound content and the About action.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "page-and-widget",
        "type": "scenario",
        "path": "pages/index/index.ink",
        "steps": [
          {
            "action": "call",
            "button": "Refresh"
          },
          {
            "action": "expect",
            "data": {
              "formatted": "1.3 km"
            }
          },
          {
            "action": "call",
            "method": "onAttach",
            "instance": "widget"
          },
          {
            "action": "expect",
            "data": {
              "formatted": "3.2 km"
            },
            "instance": "widget"
          },
          {
            "action": "seed",
            "data": {
              "reading": 0
            }
          },
          {
            "action": "call",
            "button": "Refresh"
          },
          {
            "action": "expect",
            "data": {
              "formatted": "0.0 km"
            }
          },
          {
            "action": "seed",
            "instance": "widget",
            "data": {
              "reading": -2.75
            }
          },
          {
            "action": "call",
            "method": "onAttach",
            "instance": "widget"
          },
          {
            "action": "expect",
            "data": {
              "formatted": "-2.8 km"
            },
            "instance": "widget"
          }
        ],
        "instances": {
          "widget": {
            "path": "widgets/status/index.ink"
          }
        }
      },
      {
        "id": "different-reading",
        "type": "scenario",
        "path": "pages/index/index.ink",
        "steps": [
          {
            "action": "seed",
            "data": {
              "reading": 8.04
            }
          },
          {
            "action": "call",
            "button": "Refresh"
          },
          {
            "action": "expect",
            "data": {
              "formatted": "8.0 km"
            }
          }
        ]
      }
    ],
    "regression": [
      {
        "id": "preserved-title",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "title"
      },
      {
        "id": "about-action",
        "type": "scenario",
        "path": "pages/index/index.ink",
        "steps": [
          {
            "action": "call",
            "button": "About"
          },
          {
            "action": "expect",
            "data": {
              "info": "AIUI",
              "title": "Shared Formatting"
            }
          }
        ]
      }
    ],
    "constraints": [
      {
        "id": "no-dom",
        "type": "noDom"
      }
    ]
  }
}
