{
  "schemaVersion": 1,
  "id": "007-fix-state",
  "category": "fix",
  "difficulty": "easy",
  "description": "The Increment button changes data directly, so the rendered count does not update. Fix it using the AIUI state update contract. Preserve Decrement.",
  "aiuiVersion": "current",
  "workspace": "./workspace",
  "grading": {
    "required": [
      {
        "id": "increment",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "method": "increment"
          }
        ],
        "expect": {
          "count": 1
        },
        "minPatches": 1
      }
    ],
    "regression": [
      {
        "id": "decrement",
        "type": "behavior",
        "path": "pages/index/index.ink",
        "calls": [
          {
            "method": "decrement"
          }
        ],
        "expect": {
          "count": -1
        },
        "minPatches": 1
      },
      {
        "id": "binding",
        "type": "template",
        "path": "pages/index/index.ink",
        "binding": "count"
      }
    ],
    "constraints": []
  }
}
